---
import ArrowUpRight from '../components/ArrowUpRight.astro';
import { withBase } from '../lib/paths.mjs';
import SiteLayout from '../layouts/SiteLayout.astro';
import Media from '../components/Media.astro';
import albums from '../data/albums.json';
import catalog from '../data/media.json';
import { years } from '../lib/data.mjs';
import { resolveMedia } from '../lib/media.mjs';
const categories = { meal: 'กินข้าวด้วยกัน', trip: 'ทริปและการเดินทาง', graduation: 'รับปริญญา', other: 'ช่วงเวลาอื่น ๆ' };
const ordered = [...albums].sort((a, b) => String(b.date || b.year).localeCompare(String(a.date || a.year)));
const config = { provider: import.meta.env.PUBLIC_MEDIA_PROVIDER || 'local', cloudName: import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME, cdnBase: import.meta.env.PUBLIC_MEDIA_CDN_BASE_URL, preview: import.meta.env.DEV };
const gallery = ordered.map(album => ({ id: album.id, title: album.title, year: album.year, photos: album.photos.map(id => ({ id, src: withBase(resolveMedia(catalog[id], config, 1440)), alt: catalog[id].alt, caption: catalog[id].caption || '', width: catalog[id].width, height: catalog[id].height })).filter(photo => photo.src) }));
---
<SiteLayout title="นอกเวที มีพวกเรา" active="memories">
  <section class="archive-hero memories-hero shell"><div><p class="eyebrow">OFF THE STAGE, STILL TOGETHER.</p><h1>นอกเวที<br /><em>มีพวกเรา</em></h1></div><div class="archive-hero-copy"><p>บางเรื่องไม่ต้องมีญัตติ<br />แค่มื้ออาหารหนึ่งมื้อ หรือทริปที่ไปด้วยกัน<br />ก็น่าเก็บไว้เล่าต่อ</p><p class="serif">Good ideas.<br />Even better company.</p></div></section>
  <section class="memories-collection shell" aria-label="อัลบั้มความทรงจำ"><div class="album-controls"><label>ปี<select data-album-year><option value="all">ทุกปี</option>{[...years].reverse().map(y => <option value={y}>{y} / {y + 543}</option>)}</select></label><label>ช่วงเวลาแบบไหน<select data-album-type><option value="all">ทุกกิจกรรม</option>{Object.entries(categories).map(([id, label]) => <option value={id}>{label}</option>)}</select></label><span data-album-status aria-live="polite">{ordered.length} เรื่องราว</span></div>
    <div class="album-timeline">{ordered.map(album => <article class="album-card" data-album-card data-year={album.year} data-type={album.category}><div class="album-date"><span>{album.year}</span><small>{album.date || album.year + 543}</small></div><div class="album-story"><p class="eyebrow">{categories[album.category] || categories.other}</p><h2>{album.title}</h2><p>{album.description}</p><button class="album-cover" type="button" data-gallery-open={album.id} aria-label={`เปิดอัลบั้ม ${album.title}`}><Media id={album.cover || album.photos[0]} alt={`ภาพปก ${album.title}`} /><span>ดู {album.photos.length} ภาพ <ArrowUpRight /></span></button>{album.rosterYear && <a class="text-link" href={withBase(`/members/${album.rosterYear}`)}>รู้จักทีมปี {album.rosterYear} <ArrowUpRight /></a>}</div></article>)}</div>
    <div class="memories-empty" data-album-empty hidden={ordered.length > 0}><div class="empty-photo-stack" aria-hidden="true"><span></span><span></span><span><i>our little<br />moments.</i></span></div><p class="eyebrow">MORE MOMENTS TO COME</p><h2>เว้นที่ไว้ให้<br /><em>ความทรงจำ</em></h2><p>กำลังรวบรวมภาพและเรื่องเล่าของพวกเรา<br />แล้วกลับมาเปิดอัลบั้มด้วยกันอีกครั้ง</p><a class="text-link" href="https://www.instagram.com/intaniadebateclub/">ระหว่างนี้ แวะหาเราที่ Instagram <ArrowUpRight /></a></div>
  </section>

  <script type="application/json" data-gallery-data set:html={JSON.stringify(gallery).replace(/</g, '\\u003c')}></script>
</SiteLayout>
