---
import ArrowUpRight from '../components/ArrowUpRight.astro';
import { withBase } from '../lib/paths.mjs';
import SiteLayout from '../layouts/SiteLayout.astro';
import Media from '../components/Media.astro';
import CommunityStory from '../components/CommunityStory.astro';
import { news } from '../data/news.mjs';
import data from '../data/competitions.json';
---
<SiteLayout title="ทุกเสียงมีความหมาย" active="home">
  <section class="home-hero shell" aria-labelledby="hero-title"><div class="hero-content"><p class="eyebrow">A COMMUNITY OF VOICES & IDEAS</p><h1 id="hero-title">ทุกเสียง<br />มี<em>ความหมาย</em></h1><p class="serif hero-english">Find your voice. Find your people.</p><p class="hero-description">เริ่มจากความสงสัย สู่บทสนทนาที่กว้างขึ้น<br />มาฝึกคิด ฝึกพูด และค้นพบเสียงของตัวเองไปด้วยกัน</p><a class="text-link strong-link" href="#about">รู้จัก Intania Debate Club <ArrowUpRight /></a><svg class="voice-graphic hero-voice-graphic" viewBox="0 0 216 44" fill="none" aria-hidden="true"><path d="M1 22h33c6 0 8-9 13-9 7 0 7 18 14 18 8 0 8-25 16-25 9 0 9 32 18 32 7 0 8-20 15-20 6 0 8 4 15 4h90" pathLength="1" /></svg></div><figure class="hero-visual"><Media id="microphone" eager width={1440} /><figcaption><a href="https://unsplash.com/photos/a-black-microphone-with-a-blurry-background-Nf3ko-k2TPI">ภาพ: Yoel J Gonzalez / Unsplash <ArrowUpRight /></a></figcaption></figure></section>
  <div class="intro-strip shell"><span class="eyebrow">INTANIA DEBATE CLUB</span><p>ชมรมโต้วาที คณะวิศวกรรมศาสตร์<br class="mobile-only" /> จุฬาลงกรณ์มหาวิทยาลัย</p><a href="#about" aria-label="อ่านเรื่องราวของชมรม">↓</a></div>
  <section id="about" class="section shell about-section community-about" aria-labelledby="about-title">
    <div class="about-layout">
      <CommunityStory />
      <div class="about-copy">
        <p class="eyebrow">FIND YOUR VOICE. FIND YOUR PEOPLE.</p>
        <h2 id="about-title">มากกว่าการพูด<br />คือการ<em>รับฟัง</em></h2>
        <p class="lead">มากกว่าการแข่งขัน<br />คือความสัมพันธ์ระหว่างทาง</p>
        <p>เราเริ่มจากการฝึกคิด ฝึกพูด และฟังมุมที่ต่างออกไป แล้วค่อย ๆ รู้จักกันมากขึ้น ทั้งในวันที่เตรียมขึ้นเวที และวันธรรมดาที่แค่นัดมาเจอกัน</p>
        <p>จากคนที่ไม่เคยรู้จัก กลายเป็นเพื่อนที่คอยรับฟัง เป็นเสียงเชียร์ข้างเวที และเป็นส่วนหนึ่งของความทรงจำที่อยากเก็บไว้ด้วยกัน</p>
        <p class="quiet-note">ไม่เคยโต้วาทีมาก่อน? เริ่มจากมารู้จักกันก็พอ</p>
        <a class="text-link" href="https://www.instagram.com/intaniadebateclub/">มาทักทายพวกเราทาง Instagram <ArrowUpRight /></a>
      </div>
    </div>
  </section>
  <section id="chapters" class="chapter-section shell"><div class="section-heading"><h2>เรื่องราวของเรา<br />มีมากกว่า<em>หนึ่งเวที</em></h2><p>การแข่งขัน ผู้คน และความทรงจำ<br />เลือกบทที่อยากรู้จักพวกเราให้มากขึ้น</p></div><div class="chapter-entries"><a class="chapter-entry competition-entry" href={withBase('/competitions')}><span class="chapter-number">01 / ON THE STAGE</span><h3>เส้นทาง<br /><em>การแข่งขัน</em></h3><div class="mini-route" aria-hidden="true"><i></i><span></span><i></i><span></span><i></i><span></span><i></i></div><p>2017—2026 · {data.matches.length} แมตช์ที่บันทึก<br />ทุกคู่แข่ง ทุกผลลัพธ์ มีเรื่องราวระหว่างทาง</p><span class="text-link">ย้อนดูเส้นทางของเรา <ArrowUpRight /></span></a><a class="chapter-entry people-entry" href={withBase('/members')}><span class="chapter-number">02 / OUR PEOPLE</span><h3>หกเสียง<br /><em>หนึ่งทีม</em></h3><div class="six-voices" aria-hidden="true">{[1, 2, 3, 4, 5, 6].map(n => <span>{String(n).padStart(2, '0')}</span>)}</div><p>ทำเนียบสมาชิกและนักโต้วาทีในแต่ละปี<br />ผู้คนที่อยู่เบื้องหลังทุกบทสนทนา</p><span class="text-link">รู้จักผู้คนของเรา <ArrowUpRight /></span></a><a class="chapter-entry memories-entry" href={withBase('/memories')}><span class="chapter-number">03 / OFF THE STAGE</span><h3>นอกเวที<br /><em>มีพวกเรา</em></h3><div class="memory-lines" aria-hidden="true"><span></span><span></span><span></span></div><p>มื้อที่กินด้วยกัน ทริปที่ยังเล่าถึง<br />และช่วงเวลาเล็ก ๆ ที่อยากเก็บไว้</p><span class="text-link">เปิดสมุดความทรงจำ <ArrowUpRight /></span></a></div></section>
  <section id="news" class="section news-section"><div class="shell"><div class="section-heading"><h2>เรื่องราว<em>ล่าสุด</em></h2><div class="news-filters" aria-label="กรองหมวดข่าว"><button data-filter="all" aria-pressed="true">ทั้งหมด</button><button data-filter="recruitment" aria-pressed="false">รับสมัคร</button><button data-filter="activity" aria-pressed="false">กิจกรรม</button></div></div><p class="archive-note">ประกาศย้อนหลัง · ระบุสถานะตามรอบของแต่ละกิจกรรม</p><div class="news-list">{news.map(post => <article class="news-row" data-category={post.category}><a class="news-image" href={withBase(`/posts/${post.slug}`)}><Media id={post.image} alt={`ภาพประกอบ ${post.title}`} sizes="(max-width:760px) 85px, 200px" width={400} /></a><div class="news-text"><div class="news-meta"><span>{post.label}</span><span>{post.date}</span><span class="status">{post.status}</span></div><h3><a href={withBase(`/posts/${post.slug}`)}>{post.title}</a></h3><p>{post.intro}</p></div><a class="row-arrow" href={withBase(`/posts/${post.slug}`)} aria-label={`อ่าน ${post.title}`}><ArrowUpRight /></a></article>)}</div></div></section>
  <section id="contact" class="contact-section"><div class="shell contact-inner"><div><p class="eyebrow">YOUR NEXT CHAPTER STARTS WITH A HELLO.</p><h2>บทสนทนาใหม่<br />เริ่มได้จาก<em>คำทักทาย</em></h2><p>สนใจชมรม หรืออยากรู้จักเรามากขึ้น<br />ส่งข้อความมาคุยกันได้เลย</p></div><a class="contact-round" href="https://www.instagram.com/intaniadebateclub/"><span>LET’S TALK</span><span class="large-arrow" aria-hidden="true"><ArrowUpRight /></span><span>@intaniadebateclub</span></a></div></section>
</SiteLayout>
