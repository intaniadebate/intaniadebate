---
import { withBase } from '../lib/paths.mjs';
import SiteLayout from '../layouts/SiteLayout.astro';
import YearNav from './YearNav.astro';
import Media from './Media.astro';
import rosters from '../data/rosters.json';
import { safeExternalUrl } from '../lib/data.mjs';
const { year = 2026 } = Astro.props;
const roster = rosters.find(r => r.year === year);
const hasNames = roster.members.some(m => m.fullName || m.nickname);
---
<SiteLayout title={`ทำเนียบปี ${year}`} active="members">
  <section class="archive-hero members-hero shell"><div><p class="eyebrow">THE PEOPLE BEHIND THE VOICES</p><h1>หกเสียง<br /><em>หนึ่งทีม.</em></h1></div><div class="archive-hero-copy"><p>นักโต้วาทีและสมาชิกชมรมในแต่ละปี<br />ชื่อ ใบหน้า และเรื่องราวที่ทำให้เวทีนี้มีความหมาย</p><p class="serif">Different voices.<br />One shared chapter.</p></div></section>
  <div class="archive-workspace shell"><YearNav selected={year} base="/members" label="เลือกปีทำเนียบ" /><section class="roster-chapter" aria-labelledby="roster-heading"><div class="roster-heading"><div><p class="eyebrow">INTANIA DEBATERS · {year + 543}</p><h2 id="roster-heading">Class of <em>{year}.</em></h2></div><span class="roster-count">6 คน · นักโต้และสมาชิก</span></div>
    {roster.quote && <blockquote class="roster-quote">“{roster.quote}”</blockquote>}
    {roster.groupImage && <figure class="roster-group"><Media id={roster.groupImage} alt={`ภาพสมาชิกชมรมปี ${year}`} /></figure>}
    {!hasNames && <p class="roster-pending">กำลังรวบรวมรายชื่อและภาพของทีมปี {year + 543}</p>}
    <div class="member-grid">{roster.members.map((member, i) => <article class:list={['member-card', !member.fullName && !member.nickname && 'member-pending']}><div class="member-portrait">{member.portrait ? <Media id={member.portrait} alt={`ภาพ ${member.nickname || member.fullName}`} sizes="(max-width: 600px) 45vw, 25vw" /> : <div class="portrait-pending" aria-label={`พื้นที่รูปสมาชิกคนที่ ${i + 1}`}><span>{String(i + 1).padStart(2, '0')}</span><small>THE VOICE BEHIND THE STORY</small></div>}<span class="member-index">{year} / {String(i + 1).padStart(2, '0')}</span></div><div class="member-copy"><h3>{member.nickname || member.fullName || 'รอพบเจ้าของเสียงนี้'}</h3>{member.fullName && member.nickname && <p class="member-fullname">{member.fullName}</p>}{member.quote && <p class="member-quote">“{member.quote}”</p>}{safeExternalUrl(member.instagram) && <a class="text-link" href={member.instagram} target="_blank" rel="noreferrer" aria-label={`Instagram ของ${member.nickname || member.fullName}`}>Instagram ↗</a>}{member.bio && <details class="member-bio"><summary>รู้จักกันอีกนิด ＋</summary><p>{member.bio}</p></details>}</div></article>)}</div>
    <div class="roster-outro"><p class="serif">The people make<br /><em>the story.</em></p><a class="text-link" href={withBase(`/competitions/${year}`)}>ดูเส้นทางการแข่งขันปี {year} ↗</a><a class="text-link" href={withBase(`/memories?year=${year}`)}>บรรยากาศนอกเวทีปีนี้ ↗</a></div>
  </section></div>
</SiteLayout>
