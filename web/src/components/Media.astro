---
import { withBase, srcsetWithBase } from '../lib/paths.mjs';
import catalog from '../data/media.json';
import { resolveMedia, mediaSrcset } from '../lib/media.mjs';
const { id, alt, class: className = '', eager = false, sizes = '(max-width: 760px) 100vw, 50vw', width = 960, zoom = false, photoSection = '', photoYear, memberId } = Astro.props;
const asset = catalog[id];
const config = { provider: import.meta.env.PUBLIC_MEDIA_PROVIDER || 'local', cloudName: import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME, cdnBase: import.meta.env.PUBLIC_MEDIA_CDN_BASE_URL, preview: import.meta.env.DEV };
const src = resolveMedia(asset, config, width);
const fallback = resolveMedia(asset, { provider: 'local', preview: config.preview }, width);
const enlarged = zoom && resolveMedia(asset, config, 1440);
---
{src ? enlarged ? <button type="button" class="photo-trigger" data-photo-open={id} data-photo-src={withBase(enlarged)} data-photo-alt={alt || asset.alt} data-photo-section={photoSection} data-photo-year={photoYear} data-member-id={memberId} aria-label={`ขยาย${alt || asset.alt || 'รูปภาพ'}`}><img src={withBase(src)} srcset={srcsetWithBase(mediaSrcset(asset, config))} sizes={sizes} width={asset.width} height={asset.height} alt={alt || asset.alt} class={className} data-media-id={id} data-media-fallback={withBase(fallback) || ''} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" /></button> : <img src={withBase(src)} srcset={srcsetWithBase(mediaSrcset(asset, config))} sizes={sizes} width={asset.width} height={asset.height} alt={alt || asset.alt} class={className} data-media-id={id} data-media-fallback={withBase(fallback) || ''} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" /> : <div class:list={['photo-placeholder', className]} role="img" data-media-id={id} aria-label={alt || 'พื้นที่สำหรับภาพที่จะเพิ่ม'}><span aria-hidden="true">INTANIA<br /><i>our next chapter.</i></span></div>}
