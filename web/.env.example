# Public delivery configuration. None of these values is a secret.
PUBLIC_SITE_URL=https://www.example.com
PUBLIC_BASE_PATH=/
PUBLIC_MEDIA_PROVIDER=local
PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_MEDIA_CDN_BASE_URL=

# Upload tool only: keep in .env.local or your deployment secret store.
# Never prefix credentials with PUBLIC_.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
