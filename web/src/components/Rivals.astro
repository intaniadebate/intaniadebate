---
import { withBase } from '../lib/paths.mjs';
import { rivals, years, roundName } from '../lib/data.mjs';
const { matches } = Astro.props;
const groups = rivals(matches);
---
<section id="rivals" class="rivals-section shell" aria-labelledby="rivals-title">
  <div class="rivals-intro"><div><p class="eyebrow">FAMILIAR FACES, DIFFERENT SIDES.</p><h2 id="rivals-title">คู่ปรับ<em>ตลอดกาล</em></h2></div><p>บางคณะเจอกันบ่อย บางคณะทำเราเหนื่อยทุกที<br />เรียงจากจำนวนครั้งที่เราแพ้มากที่สุด</p></div>
  <div class="rival-controls"><label>ช่วงเวลา<select data-rival-year><option value="all">ทุกปี · 2017–2026</option>{years.map(y => <option value={y}>{y} / {y + 543}</option>)}</select></label><label>รายการ<select data-rival-event><option value="all">ทุกรายการในตาราง</option><option value="freshy">CU Freshy Debate</option><option value="visionary">The Visionary Debate</option></select></label><p data-rival-status aria-live="polite">{groups.length} คณะที่เคยพบกัน</p></div>
  <div class="rival-table-wrap"><table class="rival-table"><caption class="visually-hidden">สถิติคู่แข่ง เรียงจำนวนที่วิศวะแพ้มากที่สุดก่อน</caption><thead><tr><th scope="col">#</th><th scope="col">คณะคู่แข่ง</th><th scope="col">พบกัน</th><th scope="col">เราชนะ</th><th scope="col" aria-sort="descending">เราแพ้ ↓</th><th scope="col">คู่ที่ผ่านมา</th></tr></thead><tbody data-rival-body>{groups.map((group, i) => <tr data-rival-row data-name={group.name}><td data-rank>{String(i + 1).padStart(2, '0')}</td><th scope="row">{group.name}<span class="rival-meter" aria-hidden="true"><i style={`--loss-share:${group.losses / group.matches.length * 100}%`}></i></span></th><td data-total>{group.matches.length}</td><td data-wins>{group.wins}</td><td data-losses>{group.losses}</td><td><details><summary>ดูแมตช์ <span aria-hidden="true">＋</span></summary><ul>{group.matches.map(match => <li data-rival-match data-year={match.year} data-event={match.eventId} data-result={match.result}><a href={withBase(`/competitions/${match.year}#match-${match.id}`)}>{match.year} · {match.eventId === 'freshy' ? roundName(match.order) : 'Visionary Debate'}<strong>{match.result}</strong></a></li>)}</ul></details></td></tr>)}</tbody></table></div>
  <p class="rival-empty" data-rival-empty hidden>ไม่มีแมตช์ในช่วงเวลาหรือรายการที่เลือก</p>
  <p class="source-note">สถิติจากรายการใน Excel ของชมรม · รวมผลตามที่บันทึกไว้ทั้งผลประกาศและผลสรุปจากเส้นทางแข่งขัน · เมื่อแพ้เท่ากันเรียงจำนวนที่พบกันมากกว่าก่อน</p>
</section>
