---
import ArrowUpRight from '../../components/ArrowUpRight.astro';
import { withBase } from '../../lib/paths.mjs';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Media from '../../components/Media.astro';
import { news } from '../../data/news.mjs';
export function getStaticPaths() { return news.map(post => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props;
---
<SiteLayout title={post.title} active="news"><article class="article-page shell"><a class="text-link" href={withBase('/home#news')}>← กลับไปข่าวสาร</a><div class="article-layout"><div class="article-body"><p class="eyebrow">{post.label} · {post.date}</p><h1>{post.title}</h1><p class="article-status">{post.status} · ประกาศย้อนหลัง</p><p class="lead">{post.intro}</p><div id="post-content">{post.paragraphs.map(text => <p>{text}</p>)}</div><a class="text-link" href={post.source} target="_blank" rel="noreferrer">อ่านประกาศต้นฉบับบน Instagram <ArrowUpRight /></a></div><figure class="article-art"><Media id={post.image} alt={`ภาพประกอบ ${post.title}`} /><figcaption><a href={post.source}>ภาพและประกาศต้นฉบับจาก Instagram ชมรม <ArrowUpRight /></a></figcaption></figure></div></article></SiteLayout>
